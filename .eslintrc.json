{
    "env": {
        "browser": true,
        "es6": true,
        "node": true
    },
    "extends": [
        "eslint:recommended",
        "plugin:vue/recommended"
    ],
    "globals": {
        "Atomics": "readonly",
        "SharedArrayBuffer": "readonly"
    },
    "parserOptions": {
        "sourceType": "module"
    },
    "plugins": [
         "vue"
    ],
    "rules": {
    	"indent": ["error", "tab"],
        "max-len": ["error", { "code": 128 }],
        "no-tabs": ["error"],
        "vue/html-indent": ["error", "tab"]        
    }
}
