{
    "env": {
        "browser": true,
        "es6": true,
        "node": true
    },
    "extends": [
        "eslint:recommended",
        "plugin:vue/recommended"
    ],
    "globals": {
        "Atomics": "readonly",
        "SharedArrayBuffer": "readonly"
    },
    "parserOptions": {
        "ecmaVersion": 2019,
        "sourceType": "module"
    },
    "plugins": [
         "vue"
    ],
    "rules": {
    	"indent": ["error", "tab"],
	"max-len": ["error", { "code": 128 }],
	"no-tabs": ["error", { "allowIndentationTabs": true }],
	"vue/html-indent": ["error", "tab", {
        	"attribute": 1,
                "baseIndent": 1,
                "closeBracket": 0,
                "alignAttributesVertically": true,
                "ignores": []
	}]        
    }
}
